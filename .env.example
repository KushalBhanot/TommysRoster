# Copy this file to .env.local and fill it in. Never commit .env.local.

# Gemini API key (https://aistudio.google.com/apikey). Only POST /api/match
# uses it. Without it, matching falls back to the most recent people.
GEMINI_API_KEY=

# Gemini model name, read by lib/llm.ts. Pick a fast one from
# https://aistudio.google.com/docs/models (for example gemini-3.5-flash-lite).
GEMINI_MODEL=

# true  → load data/sample-people.csv (fake rows, first_name "SAMPLE")
# unset → load data/people.csv (real people). The real demo must run with this off.
USE_SAMPLE_DATA=true
