# Copy this file to .env.local and fill it in. Never commit .env.local.

# Gemini API key (https://aistudio.google.com/apikey). Only needed for the
# moderation / briefing scripts and the /ask endpoint.
GEMINI_API_KEY=

# Gemini model name, read by lib/llm.ts.
GEMINI_MODEL=

# true  → load data/sample-advice.csv (fake rows, first_name "SAMPLE")
# unset → load data/advice.csv (real advice). The real demo must run with this off.
USE_SAMPLE_DATA=true
