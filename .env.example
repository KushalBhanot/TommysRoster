# Copy this file to .env.local and fill it in. Never commit .env.local.

# Claude API key from https://console.anthropic.com (Settings → API keys).
# Used by POST /api/match, /api/draft and /api/assistant. Without it, they
# still work but fall back to plain answers built in code (matching returns
# the most recent people with no reason).
ANTHROPIC_API_KEY=

# Optional. Claude model for matching. Defaults to claude-haiku-5-5 (fast and
# cheap). Use claude-sonnet-5-5 for higher quality at about 20x the price.
ANTHROPIC_MODEL=

# Optional. Resend API key from https://resend.com (API Keys). When set, an
# intro request is emailed to the person (if their address is known, from
# data/private/person-emails.json or their own sign-up) with reply-to set to
# the asker. Without it, requests are only stored in data/private/requests.json.
# Without a verified domain, Resend only delivers to the address the Resend
# account was created with; other recipients are refused and the request is
# just stored.
RESEND_API_KEY=

# Optional. The sender shown on intro emails. Defaults to
# "Tommy's Roster <onboarding@resend.dev>". To use your own address, verify its
# domain in Resend first.
EMAIL_FROM=

# --- USC sign-in (optional) --------------------------------------------------
# Google sign-in limited to usc.edu accounts. USC's Google accounts log in on
# USC's own NetID page, so this site never sees a password; Google only tells
# us the verified address. Leave all three empty to run with the demo sign-in.
#
# How to get the first two (about 15 minutes):
# 1. https://console.cloud.google.com → create a project.
# 2. "Google Auth Platform" → set the app name and support email, audience
#    "External", then publish the app ("In production") so any usc.edu account
#    can sign in, not only listed test users.
# 3. Clients → Create client → "Web application". Add these Authorized
#    redirect URIs (exactly, no trailing slash):
#      http://localhost:3000/api/auth/callback
#      https://YOUR-SITE.vercel.app/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Any random text of 32+ characters; make one with:
#   openssl rand -base64 48
# Use a different value on Vercel than on your laptop.
AUTH_SECRET=

# Optional. "true" keeps the demo sign-in (type a USC email, not verified)
# next to Google sign-in, for people trying the prototype without a USC
# account. Leave it off and only verified USC accounts can use the site: the
# AI routes, intro requests and roster sign-ups then all require a session.
ALLOW_DEMO_SIGNIN=

# Optional. The site's public address, without a trailing slash, if the
# server cannot tell it from the request (rarely needed; Vercel can).
SITE_URL=
