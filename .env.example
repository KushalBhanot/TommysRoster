# Copy this file to .env.local and fill it in. Never commit .env.local.

# Claude API key from https://console.anthropic.com (Settings → API keys).
# Only POST /api/match uses it. Without it, matching still works but falls
# back to the most recent people with no reason.
ANTHROPIC_API_KEY=

# Optional. Claude model for matching. Defaults to claude-haiku-5-5 (fast and
# cheap). Use claude-sonnet-5-5 for higher quality at about 20x the price.
ANTHROPIC_MODEL=

# true  → load data/sample-people.csv (fake rows, first_name "SAMPLE")
# unset → load data/people.csv (real people). The real demo must run with this off.
USE_SAMPLE_DATA=true
